(in-ns 'datascript.util)

;; CLR-compatible macros from util.cljc

(defmacro log [& body]
  nil)

(defmacro raise [& fragments]
  (let [msgs (butlast fragments)
        data (last fragments)]
    `(throw (ex-info (str ~@(map (fn [m#] (if (string? m#) m# (list 'pr-str m#))) msgs)) ~data))))

(def ^:private ^:dynamic *if+-syms nil)

(defn- if+-rewrite-cond-impl [cond]
  (clojure.core/cond
    (empty? cond)
    true
    (and (= :let (first cond)) (empty? (second cond)))
    (if+-rewrite-cond-impl (nnext cond))
    (= :let (first cond))
    (let [[var val & rest] (second cond)
          sym (gensym)]
      (vswap! *if+-syms conj [var sym])
      (list 'let [var (list 'clojure.core/vreset! sym val)]
        (if+-rewrite-cond-impl (cons :let (cons rest (nnext cond))))))
    :else
    (list 'and (first cond) (if+-rewrite-cond-impl (next cond)))))

(defn- if+-rewrite-cond [cond]
  (binding [*if+-syms (volatile! [])]
    [(if+-rewrite-cond-impl cond) @*if+-syms]))

(defn- flatten-1 [xs]
  (vec (mapcat identity xs)))

(defmacro if+ [cond then else]
  (if (and (seq? cond) (or (= 'and (first cond)) (= 'clojure.core/and (first cond))))
    (let [[cond' syms] (if+-rewrite-cond (next cond))]
      `(let ~(flatten-1 (for [[_ sym] syms] [sym '(volatile! nil)]))
         (if ~cond'
           (let ~(flatten-1 (for [[binding sym] syms] [binding (list 'deref sym)]))
             ~then)
           ~else)))
    (list 'if cond then else)))

(defmacro cond+ [& clauses]
  (when-some [[test expr & rest] clauses]
    (case test
      :do   `(do ~expr (datascript.util/cond+ ~@rest))
      :let  `(let ~expr (datascript.util/cond+ ~@rest))
      :some `(or ~expr (datascript.util/cond+ ~@rest))
      `(datascript.util/if+ ~test ~expr (datascript.util/cond+ ~@rest)))))

(defmacro some-of
  ([] nil)
  ([x] x)
  ([x & more]
   `(let [x# ~x] (if (nil? x#) (some-of ~@more) x#))))
