(ns me.tonsky.persistent-sorted-set
  "CLR-compatible replacement for the Java persistent-sorted-set library.
   Uses Clojure's built-in sorted-set-by. This is a functional shim that provides
   the same API DataScript uses. Performance optimization is future work."
  (:refer-clojure :exclude [conj disj]))

;; ── Sorted Set Wrapper ──────────────────────────────────────────────
;; DataScript uses a thin API surface from PSS:
;; - sorted-set* with :cmp option
;; - slice (range query)
;; - rslice (reverse range query)
;; - Standard Clojure set ops (conj, disj, count, seq)
;;
;; Clojure's sorted-set-by provides all of this natively.

(defn sorted-set*
  "Creates a new persistent sorted set with the given options.
   Options: :cmp — comparator function"
  [opts]
  (sorted-set-by (:cmp opts)))

(defn sorted-set-by-cmp
  "Creates a sorted set with a comparator and initial elements."
  [cmp & keys]
  (apply sorted-set-by cmp keys))

;; ── Range Queries ───────────────────────────────────────────────────

(defn slice
  "Returns elements in [from, to] range (inclusive).
   Uses subseq which works on sorted collections."
  ([s from to]
   (subseq s >= from <= to))
  ([s from]
   (subseq s >= from)))

(defn from-sorted-array
  "Creates a sorted set from a pre-sorted array and comparator."
  ([cmp arr]
   (if (nil? arr)
     (sorted-set-by cmp)
     (apply sorted-set-by cmp (seq arr))))
  ([cmp arr len]
   (from-sorted-array cmp arr))
  ([cmp arr len settings]
   (from-sorted-array cmp arr)))

(defn settings [s]
  {:branching-factor 512})

(defn seek
  "Returns a seq of elements starting from the given element."
  [s from]
  (subseq s >= from))

(defn rslice
  "Returns elements in [from, to] range in reverse order.
   Uses rsubseq which works on sorted collections."
  ([s from to]
   (rsubseq s >= to <= from))
  ([s from]
   (rsubseq s <= from)))

;; ── Set operations (aliases for clojure.core) ───────────────────────

(defn conj
  "Add element to sorted set. Extra comparator arg is accepted but ignored
   (the set already has its comparator from sorted-set-by)."
  ([s v] (clojure.core/conj s v))
  ([s v _cmp] (clojure.core/conj s v)))

(defn disj
  "Remove element from sorted set. Extra comparator arg is accepted but ignored."
  ([s v] (clojure.core/disj s v))
  ([s v _cmp] (clojure.core/disj s v)))
