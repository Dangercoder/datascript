(ns me.tonsky.persistent-sorted-set.arrays
  "CLR-compatible array utilities matching the persistent-sorted-set arrays API."
  (:refer-clojure :exclude [make-array aget aset alength aclone]))

(defn make-array
  "Creates an object array of the given size."
  [size]
  (object-array size))

(defn array?
  "Returns true if x is an array."
  [x]
  (and (some? x) (.IsArray (.GetType x))))

(defn aget
  "Gets element at index from array or lookup."
  [arr idx]
  (if (and (some? arr) (.IsArray (.GetType arr)))
    (clojure.core/aget ^objects arr idx)
    (get arr idx)))

(defn aset
  "Sets element at index in array."
  [arr idx val]
  (clojure.core/aset ^objects arr idx val))

(defn alength
  "Returns length of array."
  [arr]
  (clojure.core/alength ^objects arr))

(defn aclone
  "Clones an array or converts a seq/lookup to array."
  [arr]
  (if (and (some? arr) (.IsArray (.GetType arr)))
    (clojure.core/aclone ^objects arr)
    (clojure.core/into-array Object (map #(get arr %) (range (count arr))))))

(defn into-array
  "Converts a collection to an object array."
  [coll]
  (clojure.core/into-array Object coll))

(defn amap
  "Maps a function over an array, returning a new array."
  [f arr]
  (clojure.core/into-array Object (map f arr)))

(defn asort
  "Sorts an array in-place with a comparator."
  [arr cmp]
  (System.Array/Sort arr (reify System.Collections.IComparer
                           (Compare [_ a b] (cmp a b))))
  arr)
